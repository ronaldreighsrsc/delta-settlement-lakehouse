# Local Docker Compose environment template for Apache Airflow + Medallion Lakehouse
# Copy to .env if you want to customize local credentials or ports:
#   cp .env.example .env

# PostgreSQL metadata database credentials (local container dev only)
POSTGRES_USER=airflow
POSTGRES_PASSWORD=airflow_dev_only
POSTGRES_DB=airflow

# Apache Airflow Web UI admin credentials (local container dev only)
AIRFLOW_ADMIN_USER=admin
AIRFLOW_ADMIN_PASSWORD=admin
AIRFLOW_ADMIN_EMAIL=admin@example.com
AIRFLOW_FERNET_KEY=
AIRFLOW_WEBSERVER_PORT=8080

# Optional S3 Cloud / Local Moto ($0) Storage Overrides (used automatically by `cloud` profile)
# LAKEHOUSE_S3_BRONZE_BUCKET=s3://settlement-lakehouse-bronze-dev
# LAKEHOUSE_S3_SILVER_BUCKET=s3://settlement-lakehouse-silver-dev
# LAKEHOUSE_S3_DLQ_BUCKET=s3://settlement-lakehouse-dlq-dev
# LAKEHOUSE_S3_GOLD_BUCKET=s3://settlement-lakehouse-gold-dev
# AWS_ENDPOINT_URL=http://s3-mock:5000
# AWS_ACCESS_KEY_ID=mock_access_key
# AWS_SECRET_ACCESS_KEY=mock_secret_key
# AWS_REGION=us-east-1
# AWS_ALLOW_HTTP=true
# AWS_S3_ALLOW_UNSAFE_RENAME=true

